# Ignore everything in the root by default
/*

# But keep the bot (worker) and github actions folders
!/bot/
!/.github/
!/.gitignore
!/docs/
!/lib/
!/assets/
!/pubspec.yaml
!/pubspec.lock
!/README.md
!/render.yaml

# Ignore node_modules inside the bot
/bot/node_modules/
/bot/service_account.json
/bot/.dev.vars
/bot/secret.txt
/android/app/google-services.json

# H2H backtest scratch — regenerable with `node bot/eval_h2h.mjs`
/bot/h2h_eval_cache.json
/bot/h2h_eval_run.log
/bot/h2h_eval_full.log

# Keystores & sensitive build keys
*.jks
*.keystore
/android/key.properties
