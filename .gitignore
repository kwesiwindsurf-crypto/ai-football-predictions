# Ignore everything in the root by default
/*

# But keep the bot (worker) and github actions folders
!/bot/
!/.github/
!/.gitignore
!/docs/
!/lib/
!/assets/
!/pubspec.yaml
!/pubspec.lock
!/README.md

# Ignore node_modules inside the bot
/bot/node_modules/
/bot/service_account.json
/bot/.dev.vars
/android/app/google-services.json